major_diatonic_chords_roman_numerals = \lyricmode {
  % I - Tonic
  \markup { \fontsize #-2 "I" }
  \markup { \concat { \fontsize #-2 "I" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" } }
  \markup { \concat { \fontsize #-2 "I" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" \hspace #-0.7 \raise #0.5 \fontsize #-4 "4" } }
  % ii - Supertonic
  \markup { \fontsize #-2 "ii" }
  \markup { \concat { \fontsize #-2 "ii" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" } }
  \markup { \concat { \fontsize #-2 "ii" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" \hspace #-0.7 \raise #0.5 \fontsize #-4 "4" } }
  % iii - Mediant
  \markup { \fontsize #-2 "iii" }
  \markup { \concat { \fontsize #-2 "iii" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" } }
  \markup { \concat { \fontsize #-2 "iii" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" \hspace #-0.7 \raise #0.5 \fontsize #-4 "4" } }
  % IV - Subdominant
  \markup { \fontsize #-2 "IV" }
  \markup { \concat { \fontsize #-2 "IV" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" } }
  \markup { \concat { \fontsize #-2 "IV" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" \hspace #-0.7 \raise #0.5 \fontsize #-4 "4" } }
  % V - Dominant
  \markup { \fontsize #-2 "V" }
  \markup { \concat { \fontsize #-2 "V" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" } }
  \markup { \concat { \fontsize #-2 "V" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" \hspace #-0.7 \raise #0.5 \fontsize #-4 "4" } }
  % vi - Submediant
  \markup { \fontsize #-2 "vi" }
  \markup { \concat { \fontsize #-2 "vi" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" } }
  \markup { \concat { \fontsize #-2 "vi" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" \hspace #-0.7 \raise #0.5 \fontsize #-4 "4" } }
  % vii° - Leading Tone
  \markup { \fontsize #-2 "vii°" }
  \markup { \concat { \fontsize #-2 "vii°" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" } }
  \markup { \concat { \fontsize #-2 "vii°" \hspace #0.25 \raise #1.8 \fontsize #-4 "6" \hspace #-0.7 \raise #0.5 \fontsize #-4 "4" } }
}

